# ── Build directories ────────────────────────────────────────────────────────
build/
build-static/
build-release/
build-release-static/
build-asan/
build-coverage/
*.gcov
*.gcda
*.gcno
dist/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
install_manifest.txt
CTestTestfile.cmake

# ── Qt / MOC generated ───────────────────────────────────────────────────────
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
.qmake.stash

# ── IDE / editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
node_modules

# Jonggrang ephemeral state
.jonggrang/.ephemeral/
.jonggrang/locks/

# clangd's index, created by any editor using the compile_commands.json that
# CMAKE_EXPORT_COMPILE_COMMANDS writes into build/
.cache/

# nix build output symlink
result
result-*

# wrangler's working directory, created in the repo root by `wrangler pages
# deploy pages`. Local tool state, and its cache holds the Cloudflare account
# id and project name — neither belongs in a public repository.
.wrangler/

# An E2B API key lives in integrations/e2b/.env when the template is built by
# hand. A key is a credential, and the pattern is broad on purpose: no .env
# anywhere in this repository is ever something to commit.
.env
